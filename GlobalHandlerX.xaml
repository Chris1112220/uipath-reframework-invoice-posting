  <Sequence DisplayName="Global Exception Handler" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment DisplayName="Purpose" Text="Safety net for exceptions that escape the REFramework Try Catches (for example in Dispatcher.xaml or the final rethrow in End Process). It logs where the failure happened and re-throws (Continue) so the job ends Faulted in Orchestrator. Retries are NOT done here: REFramework and the queue already own retry logic, and retrying here could post a journal twice." sap2010:WorkflowViewState.IdRef="Comment_1"/>
    <ui:LogMessage DisplayName="Log Unhandled Exception" Level="Error" Message="[&quot;[GlobalHandlerX] Unhandled &quot; + errorInfo.Exception.GetType.Name + &quot; in activity '&quot; + errorInfo.ActivityInfo.Name + &quot;': &quot; + errorInfo.Exception.Message]" sap2010:WorkflowViewState.IdRef="LogMessage_1"/>
    <Assign DisplayName="Re-throw (Continue)" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="ui:ErrorAction">[result]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="ui:ErrorAction">[ErrorAction.Continue]</InArgument>
      </Assign.Value>
    </Assign>
  </Sequence>
</Activity>
