  <Sequence DisplayName="Test - BuildJournalEntry" sap2010:WorkflowViewState.IdRef="Sequence_4">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dtLines"/>
      <Variable x:TypeArguments="x:String" Name="strJournalId"/>
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment DisplayName="Test Purpose" Text="Builds the journal for a 1,250.50 invoice and checks the debit/credit lines, accounts, JournalId and that the entry balances." sap2010:WorkflowViewState.IdRef="Comment_2"/>
    <Sequence DisplayName="Given" sap2010:WorkflowViewState.IdRef="Sequence_1">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <ui:Comment DisplayName="No Setup" Text="Inputs are literals; no files needed." sap2010:WorkflowViewState.IdRef="Comment_1"/>
    </Sequence>
    <Sequence DisplayName="When" sap2010:WorkflowViewState.IdRef="Sequence_2">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke BuildJournalEntry" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Processing\BuildJournalEntry.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="in_InvoiceNumber">["INV-T100"]</InArgument>
          <InArgument x:TypeArguments="s:DateTime" x:Key="in_InvoiceDate">[New DateTime(2026, 9, 1)]</InArgument>
          <InArgument x:TypeArguments="s:DateTime" x:Key="in_PostingDate">[New DateTime(2026, 9, 30)]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_VendorId">["V001"]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_VendorName">["Northwind Supply Co."]</InArgument>
          <InArgument x:TypeArguments="x:Decimal" x:Key="in_Amount">[1250.50D]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_ExpenseGL">["6100-00"]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_APAccount">["2000-00"]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_JournalPrefix">["AP"]</InArgument>
          <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_JournalLines">[dtLines]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_JournalId">[strJournalId]</OutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
    </Sequence>
    <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <uta:VerifyExpression ContinueOnFailure="True" DisplayName="Verify Journal Id" Expression="[strJournalId = &quot;AP-INV-T100&quot;]" OutputMessageFormat="[&quot;JournalId should be AP-INV-T100. Actual: &quot; + strJournalId]" sap2010:WorkflowViewState.IdRef="VerifyExpression_1"/>
      <uta:VerifyExpression ContinueOnFailure="True" DisplayName="Verify Two Lines" Expression="[dtLines.Rows.Count = 2]" OutputMessageFormat="[&quot;Expected 2 journal lines. Actual: &quot; + dtLines.Rows.Count.ToString]" sap2010:WorkflowViewState.IdRef="VerifyExpression_2"/>
      <uta:VerifyExpression ContinueOnFailure="True" DisplayName="Verify Debit Line" Expression="[dtLines.Rows(0)(&quot;Account&quot;).ToString = &quot;6100-00&quot; AndAlso CDec(dtLines.Rows(0)(&quot;Debit&quot;)) = 1250.50D]" OutputMessageFormat="[&quot;Line 1 should debit expense GL 6100-00 for 1,250.50.&quot;]" sap2010:WorkflowViewState.IdRef="VerifyExpression_3"/>
      <uta:VerifyExpression ContinueOnFailure="True" DisplayName="Verify Credit Line" Expression="[dtLines.Rows(1)(&quot;Account&quot;).ToString = &quot;2000-00&quot; AndAlso CDec(dtLines.Rows(1)(&quot;Credit&quot;)) = 1250.50D]" OutputMessageFormat="[&quot;Line 2 should credit AP 2000-00 for 1,250.50.&quot;]" sap2010:WorkflowViewState.IdRef="VerifyExpression_4"/>
      <uta:VerifyExpression ContinueOnFailure="True" DisplayName="Verify Balanced" Expression="[Convert.ToDecimal(dtLines.Compute(&quot;SUM(Debit)&quot;, &quot;&quot;)) = Convert.ToDecimal(dtLines.Compute(&quot;SUM(Credit)&quot;, &quot;&quot;))]" OutputMessageFormat="[&quot;Total debits must equal total credits.&quot;]" sap2010:WorkflowViewState.IdRef="VerifyExpression_5"/>
    </Sequence>
  </Sequence>
