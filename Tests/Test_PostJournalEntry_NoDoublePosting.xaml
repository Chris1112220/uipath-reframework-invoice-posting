        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Post First Time" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" UnSafe="False" WorkflowFileName="Posting\PostJournalEntry.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="sd:DataTable" x:Key="in_JournalLines">[dtLines]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_JournalId">[strJournalId]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_JournalOutputPath">[strTempLedger]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_SheetName">["JournalEntries"]</InArgument>
          <OutArgument x:TypeArguments="x:Boolean" x:Key="out_AlreadyPosted">[blnFirstAlreadyPosted]</OutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Post Again (Simulated Retry)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_3" UnSafe="False" WorkflowFileName="Posting\PostJournalEntry.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="sd:DataTable" x:Key="in_JournalLines">[dtLines]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_JournalId">[strJournalId]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_JournalOutputPath">[strTempLedger]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_SheetName">["JournalEntries"]</InArgument>
          <OutArgument x:TypeArguments="x:Boolean" x:Key="out_AlreadyPosted">[blnSecondAlreadyPosted]</OutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
    </Sequence>
    <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
