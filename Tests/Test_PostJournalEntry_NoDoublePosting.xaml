        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <Assign DisplayName="Temp Ledger Path" sap2010:WorkflowViewState.IdRef="Assign_1">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[strTempLedger]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[Path.Combine(Path.GetTempPath, "InvoicePostingBot_Test_" + Guid.NewGuid.ToString("N") + ".xlsx")]</InArgument>
        </Assign.Value>
      </Assign>
      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Build Journal Lines" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Processing\BuildJournalEntry.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="in_InvoiceNumber">["INV-T100"]</InArgument>
          <InArgument x:TypeArguments="s:DateTime" x:Key="in_InvoiceDate">[New DateTime(2026, 9, 1)]</InArgument>
          <InArgument x:TypeArguments="s:DateTime" x:Key="in_PostingDate">[New DateTime(2026, 9, 30)]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_VendorId">["V001"]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_VendorName">["Northwind Supply Co."]</InArgument>
          <InArgument x:TypeArguments="x:Decimal" x:Key="in_Amount">[1250.50D]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_ExpenseGL">["6100-00"]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_APAccount">["2000-00"]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_JournalPrefix">["AP"]</InArgument>
          <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_JournalLines">[dtLines]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_JournalId">[strJournalId]</OutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
    </Sequence>
    <Sequence DisplayName="When" sap2010:WorkflowViewState.IdRef="Sequence_2">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
