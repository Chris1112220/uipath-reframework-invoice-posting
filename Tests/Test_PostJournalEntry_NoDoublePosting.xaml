      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment DisplayName="Test Purpose" Text="Posts the same journal twice to a temp ledger. The second call must be skipped, which is what keeps a REFramework retry from posting an invoice twice." sap2010:WorkflowViewState.IdRef="Comment_1"/>
    <Sequence DisplayName="Given" sap2010:WorkflowViewState.IdRef="Sequence_1">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
