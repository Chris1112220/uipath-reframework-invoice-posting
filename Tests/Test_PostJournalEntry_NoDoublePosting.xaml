      <Variable x:TypeArguments="sd:DataTable" Name="dtLines"/>
      <Variable x:TypeArguments="x:String" Name="strJournalId"/>
      <Variable x:TypeArguments="x:Boolean" Name="blnFirstAlreadyPosted"/>
      <Variable x:TypeArguments="x:Boolean" Name="blnSecondAlreadyPosted"/>
      <Variable x:TypeArguments="sd:DataTable" Name="dtLedger"/>
