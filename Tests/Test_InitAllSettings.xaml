  <Sequence DisplayName="Test - InitAllSettings" sap2010:WorkflowViewState.IdRef="Sequence_4">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Object)" Name="Config"/>
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment DisplayName="Test Purpose" Text="Loads Data\Config.xlsx and checks Settings, Constants, and Assets (with LocalValue fallback when Orchestrator is not available)." sap2010:WorkflowViewState.IdRef="Comment_2"/>
    <Sequence DisplayName="Given" sap2010:WorkflowViewState.IdRef="Sequence_1">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <ui:Comment DisplayName="No Setup" Text="Uses the committed Data\Config.xlsx." sap2010:WorkflowViewState.IdRef="Comment_1"/>
    </Sequence>
    <Sequence DisplayName="When" sap2010:WorkflowViewState.IdRef="Sequence_2">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke InitAllSettings" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Framework\InitAllSettings.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="in_ConfigFile">["Data\Config.xlsx"]</InArgument>
          <InArgument x:TypeArguments="s:String[]" x:Key="in_ConfigSheets">[{"Settings", "Constants"}]</InArgument>
          <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="out_Config">[Config]</OutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
    </Sequence>
    <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <uta:VerifyExpression ContinueOnFailure="True" DisplayName="Verify Queue Name" Expression="[Config.ContainsKey(&quot;OrchestratorQueueName&quot;) AndAlso Config(&quot;OrchestratorQueueName&quot;).ToString = &quot;InvoicePosting&quot;]" OutputMessageFormat="[&quot;OrchestratorQueueName should be InvoicePosting.&quot;]" sap2010:WorkflowViewState.IdRef="VerifyExpression_1"/>
      <uta:VerifyExpression ContinueOnFailure="True" DisplayName="Verify Run Mode" Expression="[Config.ContainsKey(&quot;RunMode&quot;) AndAlso {&quot;Local&quot;, &quot;Orchestrator&quot;}.Contains(Config(&quot;RunMode&quot;).ToString)]" OutputMessageFormat="[&quot;RunMode should be Local or Orchestrator.&quot;]" sap2010:WorkflowViewState.IdRef="VerifyExpression_2"/>
      <uta:VerifyExpression ContinueOnFailure="True" DisplayName="Verify MaxRetryNumber" Expression="[Config.ContainsKey(&quot;MaxRetryNumber&quot;) AndAlso IsNumeric(Config(&quot;MaxRetryNumber&quot;).ToString)]" OutputMessageFormat="[&quot;MaxRetryNumber should be numeric.&quot;]" sap2010:WorkflowViewState.IdRef="VerifyExpression_3"/>
      <uta:VerifyExpression ContinueOnFailure="True" DisplayName="Verify Asset Fallback" Expression="[Config.ContainsKey(&quot;MatchTolerancePercent&quot;) AndAlso Convert.ToDecimal(Config(&quot;MatchTolerancePercent&quot;), CultureInfo.InvariantCulture) &gt; 0D]" OutputMessageFormat="[&quot;MatchTolerancePercent should load from the asset or fall back to LocalValue.&quot;]" sap2010:WorkflowViewState.IdRef="VerifyExpression_4"/>
      <uta:VerifyExpression ContinueOnFailure="True" DisplayName="Verify AP Account" Expression="[Config.ContainsKey(&quot;APAccount&quot;) AndAlso Config(&quot;APAccount&quot;).ToString = &quot;2000-00&quot;]" OutputMessageFormat="[&quot;APAccount constant should be 2000-00.&quot;]" sap2010:WorkflowViewState.IdRef="VerifyExpression_5"/>
    </Sequence>
