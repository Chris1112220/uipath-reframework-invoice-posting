    </scg:List>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Kill All Processes" sap2010:WorkflowViewState.IdRef="Sequence_2">
    <Sequence.Variables>
      <Variable x:TypeArguments="s:String[]" Name="arrProcesses"/>
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment DisplayName="Purpose" Text="Last-resort cleanup after a system exception. Process names come from the ProcessesToKill setting so nothing is killed unless it is configured." sap2010:WorkflowViewState.IdRef="Comment_1"/>
    <Assign DisplayName="Get Configured Processes" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="s:String[]">[arrProcesses]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="s:String[]">[If(in_Config.ContainsKey("ProcessesToKill"), in_Config("ProcessesToKill").ToString, "").Split({","c}, StringSplitOptions.RemoveEmptyEntries)]</InArgument>
      </Assign.Value>
    </Assign>
    <If Condition="[arrProcesses.Length = 0]" DisplayName="If Any Processes Configured" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <ui:LogMessage DisplayName="Log Nothing To Kill" Level="Trace" Message="[&quot;No processes configured to kill.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1"/>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_1">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <ui:LogMessage DisplayName="Log Killing" Level="Warn" Message="[&quot;Killing processes: &quot; + String.Join(&quot;, &quot;, arrProcesses)]" sap2010:WorkflowViewState.IdRef="LogMessage_2"/>
          <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each Process Name" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[arrProcesses]">
            <ui:ForEach.Body>
              <ActivityAction x:TypeArguments="x:String">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="x:String" Name="processName"/>
                </ActivityAction.Argument>
                <ui:KillProcess ContinueOnError="True" DisplayName="Kill Process" ProcessName="[processName.Trim]" sap2010:WorkflowViewState.IdRef="KillProcess_1"/>
              </ActivityAction>
            </ui:ForEach.Body>
          </ui:ForEach>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>
