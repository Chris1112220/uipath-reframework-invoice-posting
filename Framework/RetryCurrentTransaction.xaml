  <Sequence DisplayName="Retry Current Transaction" sap2010:WorkflowViewState.IdRef="Sequence_4">
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment DisplayName="Purpose" Text="Queue items: Orchestrator owns retries (queue Auto Retry), so move on.&#10;Local rows: retry the same TransactionNumber up to MaxRetryNumber times." sap2010:WorkflowViewState.IdRef="Comment_1"/>
    <If Condition="[in_QueueRetry]" DisplayName="If Queue Retry" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <ui:LogMessage DisplayName="Log Queue Retry" Level="Info" Message="[&quot;Queue item set to Failed (Application). The queue's Auto Retry setting decides whether Orchestrator retries it.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1"/>
          <Assign DisplayName="Next Transaction" sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[io_TransactionNumber]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[io_TransactionNumber + 1]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Reset Retry Number" sap2010:WorkflowViewState.IdRef="Assign_2">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[io_RetryNumber]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[0]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
      <If.Else>
        <If Condition="[Convert.ToInt32(in_Config(&quot;MaxRetryNumber&quot;), CultureInfo.InvariantCulture) &gt; 0 AndAlso io_RetryNumber &lt; Convert.ToInt32(in_Config(&quot;MaxRetryNumber&quot;), CultureInfo.InvariantCulture)]" DisplayName="If Retries Remaining" sap2010:WorkflowViewState.IdRef="If_1">
          <If.Then>
            <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_1">
              <sap:WorkflowViewStateService.ViewState>
                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                  <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                </scg:Dictionary>
              </sap:WorkflowViewStateService.ViewState>
              <Assign DisplayName="Increment Retry Number" sap2010:WorkflowViewState.IdRef="Assign_3">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:Int32">[io_RetryNumber]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:Int32">[io_RetryNumber + 1]</InArgument>
                </Assign.Value>
              </Assign>
              <ui:LogMessage DisplayName="Log Retry" Level="Warn" Message="[&quot;Retrying transaction &quot; + io_TransactionNumber.ToString + &quot; (retry &quot; + io_RetryNumber.ToString + &quot; of &quot; + Convert.ToInt32(in_Config(&quot;MaxRetryNumber&quot;), CultureInfo.InvariantCulture).ToString + &quot;).&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_2"/>
            </Sequence>
          </If.Then>
          <If.Else>
            <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_2">
              <sap:WorkflowViewStateService.ViewState>
                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                  <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                </scg:Dictionary>
              </sap:WorkflowViewStateService.ViewState>
              <ui:LogMessage DisplayName="Log Max Retries" Level="Error" Message="[&quot;Max retries reached for transaction &quot; + io_TransactionNumber.ToString + &quot;. Moving to the next one.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_3"/>
              <Assign DisplayName="Next Transaction" sap2010:WorkflowViewState.IdRef="Assign_4">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:Int32">[io_TransactionNumber]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:Int32">[io_TransactionNumber + 1]</InArgument>
                </Assign.Value>
              </Assign>
              <Assign DisplayName="Reset Retry Number" sap2010:WorkflowViewState.IdRef="Assign_5">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:Int32">[io_RetryNumber]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:Int32">[0]</InArgument>
                </Assign.Value>
              </Assign>
            </Sequence>
          </If.Else>
        </If>
      </If.Else>
    </If>
  </Sequence>
