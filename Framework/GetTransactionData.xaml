  <Sequence DisplayName="Get Transaction Data" sap2010:WorkflowViewState.IdRef="Sequence_3">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataRow" Name="drInvoice"/>
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment DisplayName="Purpose" Text="Orchestrator mode: Get Transaction Item from the InvoicePosting queue.&#10;Local mode: wrap row N of the validated invoice table in a QueueItem with the same SpecificContent keys, so Process.xaml is identical in both modes." sap2010:WorkflowViewState.IdRef="Comment_1"/>
    <If Condition="[in_Config(&quot;RunMode&quot;).ToString.Equals(&quot;Orchestrator&quot;, StringComparison.OrdinalIgnoreCase)]" DisplayName="If Orchestrator Mode" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <ui:GetQueueItem DisplayName="Get Transaction Item" FolderPath="[in_Config(&quot;OrchestratorQueueFolder&quot;).ToString]" QueueType="[in_Config(&quot;OrchestratorQueueName&quot;).ToString]" TransactionItem="[out_TransactionItem]" sap2010:WorkflowViewState.IdRef="GetQueueItem_1"/>
      </If.Then>
      <If.Else>
        <If Condition="[in_LocalTransactions IsNot Nothing AndAlso in_TransactionNumber &lt;= in_LocalTransactions.Rows.Count]" DisplayName="If Local Row Available" sap2010:WorkflowViewState.IdRef="If_1">
          <If.Then>
            <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_1">
              <sap:WorkflowViewStateService.ViewState>
                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                  <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                </scg:Dictionary>
              </sap:WorkflowViewStateService.ViewState>
              <Assign DisplayName="Get Invoice Row" sap2010:WorkflowViewState.IdRef="Assign_1">
                <Assign.To>
                  <OutArgument x:TypeArguments="sd:DataRow">[drInvoice]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="sd:DataRow">[in_LocalTransactions.Rows(in_TransactionNumber - 1)]</InArgument>
                </Assign.Value>
              </Assign>
              <Assign DisplayName="Build Local Transaction Item" sap2010:WorkflowViewState.IdRef="Assign_2">
                <Assign.To>
                  <OutArgument x:TypeArguments="ui:QueueItem">[out_TransactionItem]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="ui:QueueItem">[New QueueItem With {.Reference = drInvoice("InvoiceNumber").ToString, .SpecificContent = New Dictionary(Of String, Object) From {{"InvoiceNumber", drInvoice("InvoiceNumber").ToString}, {"InvoiceDate", drInvoice("InvoiceDate").ToString}, {"VendorId", drInvoice("VendorId").ToString}, {"VendorName", drInvoice("VendorName").ToString}, {"PONumber", drInvoice("PONumber").ToString}, {"Amount", drInvoice("Amount").ToString}, {"Currency", drInvoice("Currency").ToString}, {"Description", drInvoice("Description").ToString}}}]</InArgument>
                </Assign.Value>
              </Assign>
            </Sequence>
          </If.Then>
          <If.Else>
            <Assign DisplayName="No More Local Transactions" sap2010:WorkflowViewState.IdRef="Assign_3">
              <Assign.To>
                <OutArgument x:TypeArguments="ui:QueueItem">[out_TransactionItem]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="ui:QueueItem">[Nothing]</InArgument>
              </Assign.Value>
            </Assign>
          </If.Else>
        </If>
      </If.Else>
    </If>
    <If Condition="[out_TransactionItem IsNot Nothing]" DisplayName="If Transaction Retrieved" sap2010:WorkflowViewState.IdRef="If_3">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Assign DisplayName="Set TransactionID (Invoice Number)" sap2010:WorkflowViewState.IdRef="Assign_4">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[out_TransactionID]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[out_TransactionItem.SpecificContent("InvoiceNumber").ToString]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Set TransactionField1 (Vendor)" sap2010:WorkflowViewState.IdRef="Assign_5">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[out_TransactionField1]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[out_TransactionItem.SpecificContent("VendorId").ToString]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Set TransactionField2 (Amount)" sap2010:WorkflowViewState.IdRef="Assign_6">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[out_TransactionField2]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[out_TransactionItem.SpecificContent("Amount").ToString]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:LogMessage DisplayName="Log Transaction Retrieved" Level="Info" Message="[in_Config(&quot;LogMessage_GetTransactionData&quot;).ToString + in_TransactionNumber.ToString + &quot; (&quot; + out_TransactionID + &quot;)&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1"/>
        </Sequence>
      </If.Then>
      <If.Else>
        <ui:LogMessage DisplayName="Log No More Data" Level="Info" Message="[&quot;No more transactions to process.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_2"/>
      </If.Else>
    </If>
  </Sequence>
</Activity>
