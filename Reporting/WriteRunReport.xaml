    <InvokeMethod DisplayName="Add Column ExceptionType" sap2010:WorkflowViewState.IdRef="InvokeMethod_4" MethodName="Add">
      <InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="sd:DataColumnCollection">[dtRow.Columns]</InArgument>
      </InvokeMethod.TargetObject>
      <InArgument x:TypeArguments="x:String">["ExceptionType"]</InArgument>
    </InvokeMethod>
    <InvokeMethod DisplayName="Add Column Reason" sap2010:WorkflowViewState.IdRef="InvokeMethod_5" MethodName="Add">
      <InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="sd:DataColumnCollection">[dtRow.Columns]</InArgument>
      </InvokeMethod.TargetObject>
      <InArgument x:TypeArguments="x:String">["Reason"]</InArgument>
    </InvokeMethod>
    <InvokeMethod DisplayName="Add Column JournalId" sap2010:WorkflowViewState.IdRef="InvokeMethod_6" MethodName="Add">
      <InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="sd:DataColumnCollection">[dtRow.Columns]</InArgument>
      </InvokeMethod.TargetObject>
      <InArgument x:TypeArguments="x:String">["JournalId"]</InArgument>
    </InvokeMethod>
    <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;, CultureInfo.InvariantCulture), in_Reference, in_Status, in_ExceptionType, in_Reason, in_JournalId}]" DataTable="[dtRow]" DisplayName="02 - Add Status Row" sap2010:WorkflowViewState.IdRef="AddDataRow_1"/>
    <If Condition="[File.Exists(in_ReportPath)]" DisplayName="If Report Exists" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <ui:AppendRange DataTable="[dtRow]" DisplayName="Append Status Row" SheetName="[&quot;RunReport&quot;]" WorkbookPath="[in_ReportPath]" sap2010:WorkflowViewState.IdRef="AppendRange_1"/>
      </If.Then>
      <If.Else>
        <ui:WriteRange AddHeaders="True" DataTable="[dtRow]" DisplayName="Create Report With Headers" SheetName="[&quot;RunReport&quot;]" StartingCell="A1" WorkbookPath="[in_ReportPath]" sap2010:WorkflowViewState.IdRef="WriteRange_1"/>
