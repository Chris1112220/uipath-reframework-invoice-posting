  <Sequence DisplayName="Write Run Report" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dtRow"/>
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:Comment DisplayName="Purpose" Text="Appends one status line to the run report created during Init. Failures here are swallowed by the caller so a reporting problem never stops posting." sap2010:WorkflowViewState.IdRef="Comment_1"/>
    <Assign DisplayName="01 - Create Row Table" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataTable">[dtRow]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataTable">[New DataTable]</InArgument>
      </Assign.Value>
    </Assign>
    <InvokeMethod DisplayName="Add Column Timestamp" sap2010:WorkflowViewState.IdRef="InvokeMethod_1" MethodName="Add">
      <InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="sd:DataColumnCollection">[dtRow.Columns]</InArgument>
      </InvokeMethod.TargetObject>
      <InArgument x:TypeArguments="x:String">["Timestamp"]</InArgument>
    </InvokeMethod>
    <InvokeMethod DisplayName="Add Column Reference" sap2010:WorkflowViewState.IdRef="InvokeMethod_2" MethodName="Add">
      <InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="sd:DataColumnCollection">[dtRow.Columns]</InArgument>
